{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // O `tsconfig.json` ao lado existe para EMITIR o pacote, e por isso seu `include` alcança só o
    // que vira `dist/`. Verificar tipos é outro problema: o rigor de `tsconfig.base.json` precisa
    // alcançar também o código que PROVA o pacote, senão uma conversão deliberada do teste que
    // deixou de valer compilaria, rodaria e passaria em silêncio.
    "noEmit": true,
    // `test/folha.spec.ts` alcança o acessório de varredura de `packages/db/test/` pelo caminho
    // REAL, como já fazem `apps/api`, `apps/worker`, `packages/db` e `packages/auth`. Só é aceito
    // com emissão desligada. Ver o débito D28 anotado naquele arquivo de teste.
    "allowImportingTsExtensions": true,
    // `rootDir` sobe até a raiz do repositório pelo mesmo motivo de `packages/db/tsconfig.test.json`:
    // a verificação importa acessório de fora deste pacote. Emissão desligada, então as opções de
    // artefato abaixo só produziriam conflito.
    "rootDir": "../..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
