{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/deploy/scripts/roadmap/gancho-roadmap.sh\"",
            "timeout": 30,
            "statusMessage": "Atualizando o roadmap…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/deploy/scripts/run/guarda-de-run.sh\"",
            "timeout": 15,
            "statusMessage": "Conferindo se o run tem despacho devido…"
          }
        ]
      }
    ]
  }
}
