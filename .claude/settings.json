{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash deploy/scripts/roadmap/gancho-roadmap.sh",
            "timeout": 30,
            "statusMessage": "Atualizando o roadmap…"
          }
        ]
      }
    ]
  }
}
