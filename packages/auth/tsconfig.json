{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Mesmo arranjo de `packages/db`: este pacote será REFERENCIADO por `apps/api` na T8, e
    // referência de projeto só é aceita sobre projeto composto. É o que faz `tsc --build` do
    // consumidor construir este aqui ANTES de compilar a si mesmo.
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  // `src/` importa `@sysloc/db` pelo especificador público, e o `exports` daquele manifesto
  // resolve só para `dist/` — que o `.gitignore` barra. Declarar a referência é o que faz o
  // `tsc --build` deste pacote CONSTRUIR o irmão antes de compilar aqui, inclusive sob
  // `pnpm --filter @sysloc/auth test`, que não atravessa o grafo do Turborepo.
  "references": [{ "path": "../db" }],
  "include": ["src/**/*.ts"]
}
