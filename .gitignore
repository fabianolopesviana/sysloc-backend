# Dependências
node_modules/
.pnpm-store/

# Build
dist/
build/
out/
*.tsbuildinfo
.turbo/

# Segredos — NADA aqui pode ser versionado
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
secrets/

# Dados efêmeros da verificação automatizada (ADR-0006)
# As instâncias próprias de banco e de fila da suíte nascem e morrem a cada
# execução; nada do que elas produzem pode chegar à árvore versionada.
.verificacao/

# Dados locais de desenvolvimento
.data/
*.sqlite
*.sqlite3

# Testes
coverage/
.vitest/
test-results/
playwright-report/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Artefatos efêmeros do pipeline agent-spec
docs/specs/**/_run/tmp/

# Sistema operacional / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Artefatos efêmeros das provas de falsificação de superfície (CT-012, F1/T3)
# Nascem na raiz do pacote porque é de lá que `postgres` e `./dist` resolvem —
# mover para fora exigiria plantar node_modules e trocaria fidelidade por asseio.
# O `finally` os remove; esta linha cobre a queda dura entre o writeFile e o rm.
packages/db/*-falsificad*.mjs
